{
  "name": "Rho Aias Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",

  "features": {
    // 1. Install Zsh, Oh My Zsh, and non-root user utilities
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "configureZshAsDefaultShell": "true",
      "installOhMyZsh": "true",
      "username": "node",
      "upgradePackages": "false"
    },
    // 2. Install GitHub CLI (The missing piece from previous iteration)
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // 3. Docker support (for dps/dlogs aliases)
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // 4. Git support
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-pull-request-github"
      ]
    }
  },

  // This runs AFTER the features are installed
  "postCreateCommand": "bash .devcontainer/post-create.sh && npm install"
}
